{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Servidor Flask (depurar)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Crear base de datos (init_db.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/init_db.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Verificar tablas (check_db.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/check_db.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Crear administrador (manage.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["crear-admin", "${input:correo}", "${input:nombre}"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Generar claves (manage.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["generar-claves"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pruebas (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    { "id": "correo", "type": "promptString", "description": "Correo del administrador" },
    { "id": "nombre", "type": "promptString", "description": "Nombre completo" }
  ]
}
