# Copia este archivo a .env y completa los valores. NUNCA subas .env a Git.

# "desarrollo": cookies sin Secure/HSTS. Sin SMTP_HOST, los correos se imprimen en consola.
# "produccion": exige HTTPS y SMTP_HOST.
ENTORNO=desarrollo
URL_BASE=http://localhost:5000

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=minegocioweb

# --- Secretos: genéralos con `python manage.py generar-claves` ---
SECRET_KEY=
# Si cambias TOTP_CLAVE_CIFRADO, los 2FA ya configurados dejan de funcionar.
TOTP_CLAVE_CIFRADO=

# --- Correo (SMTP con STARTTLS). Déjalo vacío para que los correos salgan por consola. ---
# Gmail:   smtp.gmail.com  | 587 | usuario = tu correo | contraseña = "contraseña de aplicación" (16 letras)
# Outlook: smtp-mail.outlook.com | 587 | usuario = tu correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=

# --- Inicio de sesión con Google / Microsoft (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
